# ============================================================
# LeadHunter Pro — Umgebungsvariablen
# Kopiere diese Datei als .env und trage deine Werte ein
# ============================================================

# Server
PORT=3000
NODE_ENV=production
BASE_URL=https://leads.deinedomain.de

# JWT
JWT_SECRET=HIER_EINEN_LANGEN_ZUFAELLIGEN_STRING_EINTRAGEN_min32zeichen

# Datenbank (MySQL bei deinem Hoster)
DB_HOST=localhost
DB_PORT=3306
DB_USER=dein_db_user
DB_PASSWORD=dein_db_passwort
DB_NAME=leadhunter

# Claude API Key — auch für die Lead-Generierung (nutzt Claudes eingebautes
# Web-Search-Tool zur Live-Verifizierung, keine separaten Such-API-Keys nötig)
CLAUDE_API_KEY=sk-ant-...

# E-Mail (SMTP — info@novaflowservices.de)
SMTP_HOST=mail.novaflowservices.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@novaflowservices.de
SMTP_PASS=dein_email_passwort
SMTP_FROM="LeadHunter Pro <info@novaflowservices.de>"

# Auto-Logout nach X Minuten Inaktivität
INACTIVITY_TIMEOUT=15

# Agent-Log (Green Bureau) — geheimer Schlüssel, den Claude Code beim Eintragen mitschickt
AGENT_LOG_KEY=HIER_EINEN_ZUFAELLIGEN_STRING_EINTRAGEN

# Canva Connect API (Green Bureau Content-Agent — Design-Erstellung bei Freigabe)
CANVA_CLIENT_ID=dein_canva_client_id
CANVA_CLIENT_SECRET=dein_canva_client_secret
CANVA_REDIRECT_URI=https://crm.novaflowservices.de/api/canva/callback

# IMAP — eingehende E-Mails automatisch Leads zuordnen
# Gleicher Server wie SMTP, Port 993 = IMAP mit SSL
IMAP_HOST=mail.novaflowservices.de
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=info@novaflowservices.de
IMAP_PASS=dein_email_passwort

# ── Browser-Telefonie (Twilio Voice) — OPTIONAL ────────────────
# Ermöglicht Anrufe direkt aus dem Browser per Headset statt über die
# Handy-App. Nicht kostenlos: laufende Kosten pro Telefonnummer (~1€/Monat)
# und pro Gesprächsminute (~1-2 Cent). Ohne diese Werte funktioniert das CRM
# weiterhin normal — "Anrufen" öffnet dann wie bisher die Telefon-App.
#
# Einrichtung:
# 1. Account auf twilio.com anlegen, Account SID + Auth Token von der
#    Console-Startseite kopieren -> TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN
# 2. Console -> Account -> API keys & tokens -> "Create API key" (Standard)
#    -> SID und Secret kopieren -> TWILIO_API_KEY_SID / TWILIO_API_KEY_SECRET
# 3. Console -> Voice -> TwiML -> TwiML Apps -> "Create new TwiML App"
#    Voice Request URL = https://DEINE-DOMAIN/api/voice/twiml (Methode: HTTP POST)
#    -> die App-SID -> TWILIO_TWIML_APP_SID
# 4. Eine Telefonnummer kaufen (Console -> Phone Numbers) oder eine bestehende
#    Nummer verifizieren (macht das CRM selbst über Einstellungen -> Anrufen)
# WICHTIG: Damit die Signaturprüfung des Voice-Webhooks funktioniert, muss der
# Webserver vor Node.js (Nginx/Apache) den Header "X-Forwarded-Proto" korrekt
# weiterleiten (siehe README, Nginx-Beispiel).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=dein_twilio_auth_token
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=dein_twilio_api_key_secret
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fallback-Absendernummer, falls ein User noch keine eigene ausgewählt hat (E.164, z.B. +49...)
TWILIO_DEFAULT_CALLER_ID=
